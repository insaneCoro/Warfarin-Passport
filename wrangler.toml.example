name = "warfarin-passport-gateway"
main = "src/index.ts"
compatibility_date = "2025-01-15"

# Non-secret settings. Use exact origins without a trailing pathname.
[vars]
FIREBASE_PROJECT_ID = "REPLACE_WITH_FIREBASE_PROJECT_ID"
APPS_SCRIPT_URL = "https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec"
ALLOWED_ORIGIN = "https://insanecoro.github.io"

# Set the signing key with `npx wrangler secret put GATEWAY_HMAC_SECRET`.
# Never place the secret value in this file or commit it to GitHub.
