/** CRUD operations on Google Sheets. User identity is verified via signed gateway assertion. */
function withLock_(fn){const lock=LockService.getScriptLock();lock.waitLock(20000);try{return fn()}finally{lock.releaseLock()}}
function patientView_(p){const o={...p};delete o.__row;return o}
function patientInput_(x,existing){
 const mrn=clean_(x.mrn??existing?.mrn,80).toUpperCase(),name=clean_(x.name??existing?.name,180),dob=clean_(x.dob??existing?.dob,10),diagnosis=clean_(x.diagnosis??existing?.diagnosis,350);
 if(!mrn||!name||!dob||!diagnosis)throw Error('MRN, name, DOB, and diagnosis are required');
 requireDate_(dob);if(dob>today_())throw Error('DOB cannot be in the future');
 const low=numericOrBlank_(x.targetLow??existing?.targetLow),high=numericOrBlank_(x.targetHigh??existing?.targetHigh);
 if((low==='')!==(high==='')||(low!==''&&(low<=0||high<=low||high>20)))throw Error('Invalid individualized INR target range');
 const enroll=clean_(x.enrollmentDate??existing?.enrollmentDate,10);
 if(enroll)requireDate_(enroll);
 const enInr=numericOrBlank_(x.enrollmentInr??existing?.enrollmentInr);
 if(enInr!==''&&(enInr<=0||enInr>20))throw Error('Invalid enrollment INR');
 return {mrn,name,dob,diagnosis,phone:clean_(x.phone??existing?.phone,40),caregiver:clean_(x.caregiver??existing?.caregiver,120),caregiverPhone:clean_(x.caregiverPhone??existing?.caregiverPhone,40),targetLow:low,targetHigh:high,enrollmentDate:enroll,enrollmentInr:enInr};
}
function patientsList_(p,user){const q=clean_(p.query,150).toLowerCase();return allRows_('Patients').filter(v=>v.status!=='Archived'&&(!q||[v.mrn,v.name,v.phone].some(s=>String(s).toLowerCase().includes(q)))).slice(0,200).map(v=>({id:v.id,mrn:v.mrn,name:v.name,dob:v.dob,diagnosis:v.diagnosis,targetLow:v.targetLow,targetHigh:v.targetHigh,status:v.status}));}
function patientGet_(p,user){const record=requirePatient_(clean_(p.patientId,80)),id=record.id;return {patient:patientView_(record),results:allRows_('INR_Results').filter(v=>v.patientId===id).map(patientView_),encounters:allRows_('Encounters').filter(v=>v.patientId===id&&v.status==='Complete').map(patientView_),dosePlans:allRows_('Dose_Plans').filter(v=>v.patientId===id).map(patientView_),followups:allRows_('Follow_Ups').filter(v=>v.patientId===id).map(patientView_),inventory:allRows_('Inventory').filter(v=>v.patientId===id).map(patientView_),notes:allRows_('Clinical_Notes').filter(v=>v.patientId===id).map(patientView_)};}
function patientCreate_(p,user){return withLock_(()=>{const data=patientInput_(p);if(allRows_('Patients').some(x=>String(x.mrn).toUpperCase()===data.mrn))throw Error('MRN already exists');const id=Utilities.getUuid();append_('Patients',{...data,id,status:'Active',createdAt:now_(),updatedAt:now_(),createdBy:user.uid,rowVersion:1});audit_(user,'patient.create','Patients',id,'New patient registered');return {id,mrn:data.mrn}})}
function patientUpdate_(p,user){return withLock_(()=>{const id=clean_(p.patientId,80),old=requirePatient_(id);if(Number(p.expectedVersion)!==Number(old.rowVersion))throw Error('Record changed by another user. Reload before editing.');const data=patientInput_(p,old);if(data.mrn!==String(old.mrn).toUpperCase()&&allRows_('Patients').some(x=>x.id!==id&&String(x.mrn).toUpperCase()===data.mrn))throw Error('MRN already exists');replace_('Patients',{...old,...data,updatedAt:now_(),rowVersion:Number(old.rowVersion)+1});audit_(user,'patient.update','Patients',id,'Demographic/clinical profile updated');return {id,rowVersion:Number(old.rowVersion)+1}})}
function encounterCreate_(p,user){return withLock_(()=>{
 const patient=requirePatient_(clean_(p.patientId,80));const key=clean_(p.requestId,100);if(!/^[a-z0-9-]{16,100}$/i.test(key))throw Error('Missing idempotency request ID');
 const existing=findRow_('Encounters','requestId',key);if(existing){if(existing.patientId!==patient.id)throw Error('Request ID collision');return {id:existing.id,status:existing.status,alreadyExists:true};}
 const date=requireDate_(clean_(p.testDate,10)),inr=Number(p.inr),next=requireDate_(clean_(p.nextInrDate,10));
 if(!Number.isFinite(inr)||inr<=0||inr>20)throw Error('Invalid INR value');if(next<date)throw Error('Next INR date cannot precede test date');
 const daily=p.daily;if(!Array.isArray(daily)||daily.length!==7||daily.some(v=>!Number.isFinite(Number(v))||Number(v)<0||Number(v)>100))throw Error('Seven validated daily doses are required');
 if(p.clinicianConfirmed!==true)throw Error('Clinician dosing confirmation required');
 const id=Utilities.getUuid(),stamp=now_(),callDate=plusCalendarDays_(next,2),doseDaily=daily.map(Number);
 // Sheets do not provide multi-sheet ACID transactions: keep a Pending encounter
 // until all linked records have been written; failed partial saves need reconciliation.
 append_('Encounters',{id,requestId:key,patientId:patient.id,testDate:date,inr,note:clean_(p.note,4000),nextInrDate:next,status:'Pending',createdAt:stamp,createdBy:user.uid});
 append_('INR_Results',{id:Utilities.getUuid(),patientId:patient.id,testDate:date,inr,enteredAt:stamp,enteredBy:user.uid,encounterId:id});
 append_('Dose_Plans',{id:Utilities.getUuid(),patientId:patient.id,encounterId:id,effectiveDate:date,sun:doseDaily[0],mon:doseDaily[1],tue:doseDaily[2],wed:doseDaily[3],thu:doseDaily[4],fri:doseDaily[5],sat:doseDaily[6],weeklyMg:doseDaily.reduce((a,b)=>a+b,0),createdAt:stamp,createdBy:user.uid});
 append_('Follow_Ups',{id:Utilities.getUuid(),patientId:patient.id,encounterId:id,inrCheckDate:next,callDueDate:callDate,status:'Pending',createdAt:stamp});
 if(clean_(p.note))append_('Clinical_Notes',{id:Utilities.getUuid(),patientId:patient.id,encounterId:id,noteDate:date,text:clean_(p.note,4000),createdAt:stamp,createdBy:user.uid});
 const rec=findRow_('Encounters','id',id);rec.status='Complete';replace_('Encounters',rec);
 audit_(user,'encounter.create','Encounters',id,'INR encounter with clinician-confirmed dose and follow-up');
 return {id,inr,callDueDate:callDate,weeklyMg:doseDaily.reduce((a,b)=>a+b,0)};
})}
function followupList_(p,user){const pending=allRows_('Follow_Ups').filter(x=>x.status!=='Completed');const people=Object.fromEntries(allRows_('Patients').map(x=>[x.id,{mrn:x.mrn,name:x.name}]));return pending.map(x=>({...patientView_(x),patient:people[x.patientId]||null})).sort((a,b)=>String(a.callDueDate).localeCompare(String(b.callDueDate))).slice(0,250)}
function followupComplete_(p,user){return withLock_(()=>{const id=clean_(p.followupId,80),f=findRow_('Follow_Ups','id',id);if(!f)throw Error('Follow-up not found');if(f.status==='Completed')return{id,status:'Completed'};f.status='Completed';f.completedAt=now_();f.outcome=clean_(p.outcome,1200);f.completedBy=user.uid;replace_('Follow_Ups',f);audit_(user,'followup.complete','Follow_Ups',id,'Contact outcome recorded');return{id,status:'Completed'}})}
function inventorySet_(p,user){return withLock_(()=>{const patient=requirePatient_(clean_(p.patientId,80)),strength=Number(p.strengthMg),qty=Number(p.quantity),date=requireDate_(clean_(p.confirmedDate,10));if(!Number.isFinite(strength)||strength<=0||strength>20||!Number.isInteger(qty)||qty<0)throw Error('Invalid stock count or strength');const existing=allRows_('Inventory').find(x=>x.patientId===patient.id&&Number(x.strengthMg)===strength),old=existing?Number(existing.quantity):0,id=existing?existing.id:Utilities.getUuid();const record={id,patientId:patient.id,strengthMg:strength,quantity:qty,confirmedDate:date,updatedAt:now_(),updatedBy:user.uid};existing?replace_('Inventory',{...existing,...record}):append_('Inventory',record);append_('Inventory_Log',{id:Utilities.getUuid(),patientId:patient.id,strengthMg:strength,oldQuantity:old,newQuantity:qty,confirmedDate:date,actorUid:user.uid,createdAt:now_()});audit_(user,'inventory.set','Inventory',id,'Confirmed tablet count updated');return{id,quantity:qty}})}
function noteCreate_(p,user){return withLock_(()=>{const patient=requirePatient_(clean_(p.patientId,80)),text=clean_(p.text,4000),date=requireDate_(clean_(p.noteDate,10));if(!text)throw Error('Clinical note cannot be empty');const id=Utilities.getUuid();append_('Clinical_Notes',{id,patientId:patient.id,encounterId:'',noteDate:date,text,createdAt:now_(),createdBy:user.uid});audit_(user,'note.create','Clinical_Notes',id,'Clinical note saved');return{id}})}
function userUpsert_(p,user){requireAdmin_(user);return withLock_(()=>{const uid=clean_(p.uid,128),email=clean_(p.email,160).toLowerCase(),role=clean_(p.role,20),name=clean_(p.displayName,120);if(!uid||!email||!['admin','subadmin'].includes(role))throw Error('Invalid staff user');const existing=findRow_('Users','firebaseUid',uid),record={firebaseUid:uid,email,role,active:p.active===false?'false':'true',displayName:name,createdAt:existing?.createdAt||now_(),updatedAt:now_()};existing?replace_('Users',{...existing,...record}):append_('Users',record);audit_(user,'users.upsert','Users',uid,'Staff role/active status updated');return{uid,role}})}
